          "next": "done1",
          "if": [
            {
              "if": "org_offer_accepted",
              "n": 1
            }
          ]
        },
        {
          "text": "Сдать задание 2",
          "next": "done2",
          "if": [
            {
              "if": "org_offer_accepted",
              "n": 2
            }
          ]
