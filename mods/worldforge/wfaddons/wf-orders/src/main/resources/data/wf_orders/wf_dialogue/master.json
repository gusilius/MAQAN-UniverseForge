      "speaker": "{npc_title}",
      "do": [
        {
          "do": "org_status"
        }
      ],
      "text": "{reply}\n\nВы говорите с представителем организации «{org_name}». Ваше звание: {org_rank}.",
      "choices": [
        {
          "text": "Хочу вступить (взнос {org_join_gold} золота)",
          "next": "join",
          "if": [
            {
              "if": "org_can_join"
            }
          ]
        },
        {
          "text": "Какие у вас есть задания?",
          "next": "offers",
          "if": [
            {
              "if": "org_member"
            }
          ]
        },
        {
          "text": "Взять задание 1",
          "next": "acc1",
          "if": [
            {
              "if": "org_member"
            },
            {
              "if": "org_offer_open",
              "n": 1
            }
          ]
        },
        {
          "text": "Взять задание 2",
          "next": "acc2",
          "if": [
            {
              "if": "org_member"
            },
            {
              "if": "org_offer_open",
              "n": 2
            }
          ]
        },
