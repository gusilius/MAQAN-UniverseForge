{
  "id": "wf_people:marshal",
  "start": "hello",
  "nodes": {
    "hello": {
      "speaker": "{npc_title}",
      "text": "Маршал {npc} к вашим услугам, {player}.",
      "choices": [
        {
          "text": "Отдать распоряжение",
          "next": "d_menu",
          "if": [
            {
              "if": "player_has_realm"
            },
            {
              "if": "npc_realm_is_yours"
            }
          ]
        },
        {
          "text": "Нет ли для меня поручения?",
          "next": "q_list",
          "if": [
            {
              "if": "quest_offers_exist"
            }
          ]
        },
        {
          "text": "Я по поводу вашего дела",
          "next": "q_report",
          "if": [
            {
              "if": "quest_interactable"
            }
          ]
        },
        {
          "text": "Поговорим о торговле",
          "next": "t_menu",
          "if": [
            {
              "if": "trade_market_exists"
            }
          ]
        },
        {
          "text": "Пообщаться по душам",
          "next": "s_menu"
        },
        {
          "text": "Всего доброго."
        }
      ]
    },
    "s_menu": {
      "speaker": "{npc_title}",
      "do": [
        {
          "do": "npc_refresh"
        }
      ],
      "text": "{hearts}  {mood}. {reply}",
      "choices": [
        {
          "text": "Поболтать",
          "next": "s_chat",
          "if": [
            {
              "if": "npc_ready",
              "kind": "chat"
            }
          ]
        },
        {
          "text": "Пошутить",
          "next": "s_joke",
          "if": [
            {
              "if": "npc_ready",
              "kind": "joke"
            }
          ]
        },
        {
          "text": "Сделать комплимент",
          "next": "s_compliment",
          "if": [
            {
              "if": "npc_ready",
              "kind": "compliment"
            }
          ]
        },
        {
          "text": "Флиртовать",
          "next": "s_flirt",
          "if": [
            {
              "if": "npc_ready",
              "kind": "flirt"
            },
            {
              "if": "not",
              "of": [
                {
                  "if": "npc_married_to_you"
                }
              ]
            }
          ]
        },
        {
          "text": "Обнять",
          "next": "s_hug",
          "if": [
            {
              "if": "npc_ready",
              "kind": "hug"
            }
          ]
        },
        {
          "text": "Поцеловать",
          "next": "s_kiss",
          "if": [
            {
              "if": "npc_ready",
              "kind": "kiss"
            }
          ]
        },
        {
          "text": "Подарить то, что в руке",
          "next": "s_gift"
        },
        {
          "text": "Что слышно нового?",
          "next": "s_rumor"
        },
        {
          "text": "Нет ли для меня дела?",
          "next": "s_req_offer",
          "if": [
            {
              "if": "not",
              "of": [
                {
                  "if": "npc_has_request"
                }
              ]
            }
          ]
        },
        {
          "text": "Я принёс, что вы просили.",
          "next": "s_req_done",
          "if": [
            {
              "if": "npc_request_ready"
            }
          ]
        },
        {
          "text": "Напомните, о чём вы просили.",
          "next": "s_req_show",
          "if": [
            {
              "if": "npc_has_request"
            },
            {
              "if": "not",
              "of": [
                {
                  "if": "npc_request_ready"
                }
              ]
            }
          ]
        },
        {
          "text": "Предложить встречаться",
          "next": "s_date",
          "if": [
            {
              "if": "npc_can_date"
            }
          ]
        },
        {
          "text": "Предложить руку и сердце",
          "next": "s_marry",
          "if": [
            {
              "if": "npc_can_marry"
            }
          ]
        },
        {
          "text": "Расстаться",
          "next": "s_split",
          "if": [
            {
              "if": "npc_dating"
            },
            {
              "if": "not",
              "of": [
                {
                  "if": "npc_married_to_you"
                }
              ]
            }
          ]
        },
        {
          "text": "Развестись",
          "next": "s_split",
          "if": [
            {
              "if": "npc_married_to_you"
            }
          ]
        },
        {
          "text": "Вернуться к делам",
          "next": "hello"
        }
      ]
    },
